<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="group_document_approver_user" model="res.groups">
        <field name="name">Approver</field>
        <field
            name="implied_ids"
            eval="[(4, ref('document_page.group_document_editor'))]"
        />
    </record>
    <record id="document_page.group_document_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_document_approver_user'))]" />
    </record>
    <!-- Odoo 20 : ir.rule + ir.model.access -> ir.access. Les accès génériques de
         document_page sur l'historique sont remplacés par des accès selon l'état de
         la demande de changement : brouillons visibles par leur auteur seulement,
         sauf pour les approbateurs (non-brouillons) et le gestionnaire (tout). -->
    <record id="document_page.document_page_history_user" model="ir.access">
        <field name="active" eval="False" />
    </record>
    <record id="document_page.document_page_history_editor" model="ir.access">
        <field name="active" eval="False" />
    </record>
    <record id="rule_change_request_global" model="ir.access">
        <field name="name">Change Request Global</field>
        <field name="model_id" ref="document_page.model_document_page_history" />
        <field name="group_id" ref="document_knowledge.group_document_user" />
        <field name="operation">r</field>
        <field name="domain">['|',('state','=','approved'),('create_uid','=',user.id)]</field>
    </record>
    <record id="rule_change_request_editor" model="ir.access">
        <field name="name">Change Request Editor</field>
        <field name="model_id" ref="document_page.model_document_page_history" />
        <field name="group_id" ref="document_page.group_document_editor" />
        <field name="operation">cru</field>
        <field name="domain">['|',('state','=','approved'),('create_uid','=',user.id)]</field>
    </record>
    <record id="rule_change_request_approver" model="ir.access">
        <field name="name">Change Request Approver</field>
        <field name="model_id" ref="document_page.model_document_page_history" />
        <field name="group_id" ref="group_document_approver_user" />
        <field name="operation">cru</field>
        <field name="domain">[('state','!=','draft')]</field>
    </record>
    <record id="rule_change_request_manager" model="ir.access">
        <field name="name">Change Request Manager</field>
        <field name="model_id" ref="document_page.model_document_page_history" />
        <field name="group_id" ref="document_page.group_document_manager" />
        <field name="operation">cru</field>
    </record>
</odoo>
