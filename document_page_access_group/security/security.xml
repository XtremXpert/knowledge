<odoo>
    <!-- Odoo 20 : les accès génériques de document_page sont remplacés par des
         accès limités aux pages ouvertes à l'utilisateur ou à l'un de ses groupes ;
         le gestionnaire garde l'accès complet (document_page.document_page_manager). -->
    <record id="document_page.document_page_user" model="ir.access">
        <field name="active" eval="False" />
    </record>
    <record id="document_page.document_page_editor" model="ir.access">
        <field name="active" eval="False" />
    </record>
    <record id="document_page_rule" model="ir.access">
        <field name="name">Document Page Access</field>
        <field name="model_id" ref="document_page.model_document_page" />
        <field name="group_id" ref="document_knowledge.group_document_user" />
        <field name="operation">r</field>
        <field
            name="domain"
        >['|', ('groups_id', 'in', user.group_ids.ids), '|', ('user_ids', 'in', [user.id]), '&amp;', ('groups_id', '=', False), ('user_ids', '=', False)]</field>
    </record>
    <record id="document_page_rule_editor" model="ir.access">
        <field name="name">Document Page Access (editor)</field>
        <field name="model_id" ref="document_page.model_document_page" />
        <field name="group_id" ref="document_page.group_document_editor" />
        <field name="operation">cru</field>
        <field
            name="domain"
        >['|', ('groups_id', 'in', user.group_ids.ids), '|', ('user_ids', 'in', [user.id]), '&amp;', ('groups_id', '=', False), ('user_ids', '=', False)]</field>
    </record>
</odoo>
