#. module: knowledge_templates
#: model:knowledge.page.template,content:knowledge_templates.template_procedure
msgid ""
"<h2>Purpose</h2>\n"
"<p>What this procedure is for, in one sentence.</p>\n"
"<h2>When</h2>\n"
"<p>Frequency or trigger (e.g. every autumn, after a power outage).</p>\n"
"<h2>Materials</h2>\n"
"<ul><li>Tool or product</li></ul>\n"
"<h2>Steps</h2>\n"
"<ol><li>First step</li><li>Second step</li></ol>\n"
"<h2>Precautions</h2>\n"
"<p>Safety notes, what not to do.</p>\n"
"        "
msgstr ""
"<h2>Objet</h2>\n"
"<p>À quoi sert cette procédure, en une phrase.</p>\n"
"<h2>Quand</h2>\n"
"<p>Fréquence ou déclencheur (p. ex. chaque automne, après une panne de courant).</p>\n"
"<h2>Matériel</h2>\n"
"<ul><li>Outil ou produit</li></ul>\n"
"<h2>Étapes</h2>\n"
"<ol><li>Première étape</li><li>Deuxième étape</li></ol>\n"
"<h2>Précautions</h2>\n"
"<p>Consignes de sécurité, ce qu'il ne faut pas faire.</p>\n"
"        "

#. module: knowledge_templates
#: model:knowledge.page.template,content:knowledge_templates.template_meeting
msgid ""
"<p><strong>Date:</strong> <br></p>\n"
"<p><strong>Participants:</strong> <br></p>\n"
"<h2>Agenda</h2>\n"
"<ul><li>Topic</li></ul>\n"
"<h2>Decisions</h2>\n"
"<ul><li>Decision</li></ul>\n"
"<h2>Actions</h2>\n"
"<ul class=\"o_checklist\"><li>Who does what, by when</li></ul>\n"
"        "
msgstr ""
"<p><strong>Date :</strong> <br></p>\n"
"<p><strong>Participants :</strong> <br></p>\n"
"<h2>Ordre du jour</h2>\n"
"<ul><li>Sujet</li></ul>\n"
"<h2>Décisions</h2>\n"
"<ul><li>Décision</li></ul>\n"
"<h2>Actions</h2>\n"
"<ul class=\"o_checklist\"><li>Qui fait quoi, pour quand</li></ul>\n"
"        "

#. module: knowledge_templates
#: model:knowledge.page.template,content:knowledge_templates.template_recipe
msgid ""
"<p><strong>Servings:</strong> 4 · <strong>Preparation:</strong> 15 min · <strong>Cooking:</strong> 30 min</p>\n"
"<h2>Ingredients</h2>\n"
"<ul><li>Ingredient and quantity</li></ul>\n"
"<h2>Steps</h2>\n"
"<ol><li>First step</li><li>Second step</li></ol>\n"
"<h2>Notes</h2>\n"
"<p>Variations, tips, what to serve with it.</p>\n"
"        "
msgstr ""
"<p><strong>Portions :</strong> 4 · <strong>Préparation :</strong> 15 min · <strong>Cuisson :</strong> 30 min</p>\n"
"<h2>Ingrédients</h2>\n"
"<ul><li>Ingrédient et quantité</li></ul>\n"
"<h2>Étapes</h2>\n"
"<ol><li>Première étape</li><li>Deuxième étape</li></ol>\n"
"<h2>Notes</h2>\n"
"<p>Variantes, astuces, accompagnements.</p>\n"
"        "

#. module: knowledge_templates
#: model:knowledge.page.template,content:knowledge_templates.template_equipment
msgid ""
"<table class=\"table table-bordered\">\n"
"<tbody>\n"
"<tr><td><strong>Brand and model</strong></td><td><br></td></tr>\n"
"<tr><td><strong>Serial number</strong></td><td><br></td></tr>\n"
"<tr><td><strong>Purchase date</strong></td><td><br></td></tr>\n"
"<tr><td><strong>Supplier</strong></td><td><br></td></tr>\n"
"<tr><td><strong>Warranty until</strong></td><td><br></td></tr>\n"
"</tbody>\n"
"</table>\n"
"<h2>Maintenance</h2>\n"
"<ul class=\"o_checklist\"><li>Yearly check</li><li>Filter or part to replace</li></ul>\n"
"<h2>Manuals and documents</h2>\n"
"<p>Links to the manual, invoice, warranty.</p>\n"
"<h2>History</h2>\n"
"<p>Repairs and interventions, with dates.</p>\n"
"        "
msgstr ""
"<table class=\"table table-bordered\">\n"
"<tbody>\n"
"<tr><td><strong>Marque et modèle</strong></td><td><br></td></tr>\n"
"<tr><td><strong>Numéro de série</strong></td><td><br></td></tr>\n"
"<tr><td><strong>Date d'achat</strong></td><td><br></td></tr>\n"
"<tr><td><strong>Fournisseur</strong></td><td><br></td></tr>\n"
"<tr><td><strong>Garantie jusqu'au</strong></td><td><br></td></tr>\n"
"</tbody>\n"
"</table>\n"
"<h2>Entretien</h2>\n"
"<ul class=\"o_checklist\"><li>Vérification annuelle</li><li>Filtre ou pièce à remplacer</li></ul>\n"
"<h2>Manuels et documents</h2>\n"
"<p>Liens vers le manuel, la facture, la garantie.</p>\n"
"<h2>Historique</h2>\n"
"<p>Réparations et interventions, avec les dates.</p>\n"
"        "

