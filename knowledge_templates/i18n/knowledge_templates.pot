#. module: knowledge_templates
#: model:knowledge.page.template,content:knowledge_templates.template_procedure
msgid ""
"<h2>Purpose</h2>\n"
"<p>What this procedure is for, in one sentence.</p>\n"
"<h2>When</h2>\n"
"<p>Frequency or trigger (e.g. every autumn, after a power outage).</p>\n"
"<h2>Materials</h2>\n"
"<ul><li>Tool or product</li></ul>\n"
"<h2>Steps</h2>\n"
"<ol><li>First step</li><li>Second step</li></ol>\n"
"<h2>Precautions</h2>\n"
"<p>Safety notes, what not to do.</p>\n"
"        "
msgstr ""

#. module: knowledge_templates
#: model:knowledge.page.template,content:knowledge_templates.template_meeting
msgid ""
"<p><strong>Date:</strong> <br></p>\n"
"<p><strong>Participants:</strong> <br></p>\n"
"<h2>Agenda</h2>\n"
"<ul><li>Topic</li></ul>\n"
"<h2>Decisions</h2>\n"
"<ul><li>Decision</li></ul>\n"
"<h2>Actions</h2>\n"
"<ul class=\"o_checklist\"><li>Who does what, by when</li></ul>\n"
"        "
msgstr ""

#. module: knowledge_templates
#: model:knowledge.page.template,content:knowledge_templates.template_recipe
msgid ""
"<p><strong>Servings:</strong> 4 · <strong>Preparation:</strong> 15 min · <strong>Cooking:</strong> 30 min</p>\n"
"<h2>Ingredients</h2>\n"
"<ul><li>Ingredient and quantity</li></ul>\n"
"<h2>Steps</h2>\n"
"<ol><li>First step</li><li>Second step</li></ol>\n"
"<h2>Notes</h2>\n"
"<p>Variations, tips, what to serve with it.</p>\n"
"        "
msgstr ""

#. module: knowledge_templates
#: model:knowledge.page.template,content:knowledge_templates.template_equipment
msgid ""
"<table class=\"table table-bordered\">\n"
"<tbody>\n"
"<tr><td><strong>Brand and model</strong></td><td><br></td></tr>\n"
"<tr><td><strong>Serial number</strong></td><td><br></td></tr>\n"
"<tr><td><strong>Purchase date</strong></td><td><br></td></tr>\n"
"<tr><td><strong>Supplier</strong></td><td><br></td></tr>\n"
"<tr><td><strong>Warranty until</strong></td><td><br></td></tr>\n"
"</tbody>\n"
"</table>\n"
"<h2>Maintenance</h2>\n"
"<ul class=\"o_checklist\"><li>Yearly check</li><li>Filter or part to replace</li></ul>\n"
"<h2>Manuals and documents</h2>\n"
"<p>Links to the manual, invoice, warranty.</p>\n"
"<h2>History</h2>\n"
"<p>Repairs and interventions, with dates.</p>\n"
"        "
msgstr ""

