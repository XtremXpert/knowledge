<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Public read-only page: standalone, no website or backend assets. -->
    <template id="public_page" name="Shared wiki page">&lt;!DOCTYPE html&gt;
        <html t-att-lang="(page.create_uid.lang or 'en_US').replace('_', '-')">
        <head>
            <meta charset="utf-8" />
            <meta name="viewport" content="width=device-width, initial-scale=1" />
            <meta name="robots" content="noindex, nofollow" />
            <title t-out="page.name" />
            <style>
                    :root {
                        --text: #1f2328; --muted: #656d76; --line: #d8dee4;
                        --soft: #f6f8fa; --accent: #714b67; --bg: #ffffff;
                    }
                    @media (prefers-color-scheme: dark) {
                        :root {
                            --text: #e6edf3; --muted: #9198a1; --line: #3d444d;
                            --soft: #151b23; --accent: #c39bb8; --bg: #0d1117;
                        }
                    }
                    * { box-sizing: border-box; }
                    body {
                        margin: 0; background: var(--bg); color: var(--text);
                        font: 17px/1.7 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
                    }
                    .cover { height: 240px; background: center / cover no-repeat var(--soft); }
                    article { max-width: 760px; margin: 0 auto; padding: 2.5rem 16px 3rem; }
                    h1.title { font-size: 2.4rem; line-height: 1.2; margin: 0 0 .5rem; }
                    .meta { color: var(--muted); font-size: .9rem; margin-bottom: 2rem; }
                    .meta span + span::before { content: " · "; }
                    .content img { max-width: 100%; height: auto; border-radius: 6px; }
                    .content table { width: 100%; border-collapse: collapse; margin: 1rem 0; }
                    .content td, .content th { border: 1px solid var(--line); padding: .45rem .7rem; }
                    .content pre, .content code { background: var(--soft); border-radius: 4px; }
                    .content pre { padding: .8rem 1rem; overflow-x: auto; }
                    .content blockquote {
                        margin: 1rem 0; padding: .2rem 1rem;
                        border-left: 3px solid var(--line); color: var(--muted);
                    }
                    .content a { color: var(--accent); }
                    .content ul.o_checklist { list-style: none; padding-left: 1.2rem; }
                    .content ul.o_checklist > li::before { content: "☐  "; }
                    .content ul.o_checklist > li.o_checked::before { content: "☑  "; }
                    .content ul.o_checklist > li.o_checked { color: var(--muted); text-decoration: line-through; }
                    footer {
                        max-width: 760px; margin: 0 auto; padding: 1.5rem 16px 3rem;
                        border-top: 1px solid var(--line); color: var(--muted); font-size: .85rem;
                        display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; justify-content: space-between;
                    }
                    footer a { color: var(--accent); }
                </style>
        </head>
        <body>
            <div
                t-if="page.image"
                class="cover"
                t-attf-style="background-image: url('/knowledge/share/#{token}/cover')"
            />
            <article>
                <h1 class="title" t-out="page.name" />
                <div class="meta">
                    <span t-if="page.parent_id" t-out="page.parent_id.name" />
                    <span>
                        <t t-out="labels['updated']" />
                        <t t-out="page.content_date" t-options="{'widget': 'date'}" />
                    </span>
                </div>
                <div class="content" t-out="content" />
            </article>
            <footer>
                <span t-out="labels['footer']" />
                <a t-attf-href="/knowledge/share/#{token}/pdf" t-out="labels['pdf']" />
            </footer>
        </body>
    </html>
    </template>
</odoo>
