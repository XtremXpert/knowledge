<templates xml:space="preserve">
    <t t-inherit="mail.Chatter" t-inherit-mode="extension">
        <!-- boîte des pièces jointes : à côté de « Attach files » -->
        <xpath
            expr="//div[hasclass('o-mail-Chatter-attachmentActions')]//FileUploader"
            position="after"
        >
            <button
                class="o-document-url-addUrl btn btn-link px-1"
                type="button"
                t-att-disabled="!this.canAddUrl"
                t-on-click="() => this.onClickAddUrl()"
            >
                <i class="oi me-1" data-icon="link" />
                Add URL
            </button>
        </xpath>
        <!-- barre du haut, tant qu'il n'y a aucune pièce jointe (la boîte ne s'ouvre pas) -->
        <xpath expr="//div[hasclass('o-mail-Followers')]" position="before">
            <button
                t-if="this.attachments.length === 0"
                class="o-document-url-addUrl btn btn-link px-1"
                type="button"
                title="Add URL"
                aria-label="Add URL"
                t-att-disabled="!this.canAddUrl"
                t-on-click="() => this.onClickAddUrl()"
            >
                <i class="oi oi-fw" data-icon="link" />
            </button>
        </xpath>
    </t>
</templates>
